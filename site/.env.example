# 官网服务配置（复制为 .env 后修改；.env 不进版本库）
# 端口与地址
PORT=8099
HOST=0.0.0.0
SITE_URL=http://localhost:8099
SITE_NAME=MSERM
SITE_TAGLINE=从线索到回款的集团 CRM
SITE_REPO=https://gitee.com/Emcloud_admin/mserm-crm

# 首个管理员：首次启动时创建；不填密码则随机生成并打印到控制台
SITE_ADMIN_EMAIL=admin@example.com
SITE_ADMIN_PASSWORD=ChangeMe123

# 会员库与安装包目录
SITE_DB=./data/site.db
SITE_RELEASE_DIR=../release
SITE_DAILY_DOWNLOAD_LIMIT=20
SITE_MAX_UPLOAD_MB=200
SITE_SESSION_DAYS=30
# 通过 HTTPS 访问时置 1，Cookie 会带 Secure
SITE_SECURE_COOKIE=0

# 邮件（注册验证码）。不配置时验证码直接打印到控制台，且注册免验证
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=MSERM 官网
# 配置 SMTP 后是否强制校验验证码
SITE_REQUIRE_CODE=1
