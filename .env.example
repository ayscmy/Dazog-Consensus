# 主系统配置（复制为 .env；.env 已被 .gitignore 忽略）
PORT=8081
HOST=0.0.0.0

# SQLite 文件位置。开源版首次启动是空库，由 /setup.html 创建管理员
CRM_DB=./data/crm.db

# 关闭 /api 访问日志可设 0
CRM_LOG=1

# 官网地址：安装向导与「获取演示数据库」入口会跳转到这里
SITE_URL=http://localhost:8099

# 发行标识，会显示在 /api/setup/status
CRM_EDITION=community

# ---------- 演示模式（官网「在线测试」用，正式环境不要开） ----------
# 打开后访问 /demo 会直接以演示账号登录，界面上会显示「演示环境」标识
DEMO_MODE=0
# 演示账号（需在库里存在且状态正常）
DEMO_USER=admin
# 提示里的重置周期（小时）；真正的重置靠外部脚本/定时任务换库
DEMO_RESET_HOURS=24
# 演示实例顶栏「返回官网」的地址，留空则不显示
DEMO_HOME=
