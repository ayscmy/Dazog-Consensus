# 主系统配置（复制为 .env；.env 已被 .gitignore 忽略，不会进入仓库）
PORT=8081
HOST=0.0.0.0

# ================= 数据库：二选一，由部署者在配置文件里决定 =================
#
# 【默认】SQLite —— 零依赖、单文件，什么都不用配就能跑（推荐小团队 / 单机部署）
#   DB_TYPE=sqlite
#   （可选）指定数据文件位置，默认 ./data/crm.db
#   DB_FILE=./data/crm.db
#
# 【可选】PostgreSQL —— 多人并发 / 需要与外部系统共用库时启用
#   设置 DB_TYPE=postgres 后，连接信息优先取 DATABASE_URL，取不到则用下面的 PG_* 拼装。
#   注意：一旦配置了 DATABASE_URL 而 DB_TYPE 未填，系统会自动按 PostgreSQL 处理。
#
# =========================== 当前选择 ===========================
# DB_TYPE=sqlite
# DB_FILE=./data/crm.db

# ---------- PostgreSQL 连接（仅 DB_TYPE=postgres 时需要） ----------
# DB_TYPE=postgres
# 例：postgres://用户名:密码@主机:5432/库名?sslmode=disable
# DATABASE_URL=postgres://用户名:密码@127.0.0.1:5432/mscrm?sslmode=disable
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_DATABASE=mscrm
# PG_USER=mscrm
# PG_PASSWORD=
# PG_SSLMODE=disable
# CRM 全部表所在 schema（与销售系统 public schema 隔离，避免撞表）
# PG_SCHEMA=crm

# 关闭 /api 访问日志可设 0
CRM_LOG=1

# 官网地址：安装向导与「获取演示数据库」入口会跳转到这里
SITE_URL=http://localhost:8099

# 发行标识，会显示在 /api/setup/status
# community = 社区版（免费，默认限制 10 个在职用户，仅限个人学习/研究）
# pro / enterprise = 商业授权（默认不限人数）
CRM_EDITION=community

# 在职用户上限。留空 = 按版本取默认（社区版 10，商业版不限）；填 0 = 不限
# 注意：只统计在职用户，离职/停用不占用；官网自动开通的试用账号也不占用
CRM_USER_LIMIT=

# 超出上限时「前往官网了解授权」按钮跳转的地址
CRM_UPGRADE_URL=https://office.aiemy.com/?from=crm#pricing

# ---------- 演示模式（官网「在线测试」用，正式环境不要开） ----------
DEMO_MODE=0
DEMO_USER=admin
DEMO_RESET_HOURS=24
DEMO_HOME=

# ---------- 官网试用账号（官网注册后自动开通，到期自动回收）----------
# 与官网 .env 的 CRM_TRIAL_KEY 必须完全一致；留空则关闭内部接口
TRIAL_API_KEY=
# 试用天数
TRIAL_DAYS=7
# 试用账号挂载的父组织（不存在会自动创建）
TRIAL_ROOT_NAME=试用中心
# 邮件与页面里给会员的访问地址
TRIAL_URL=https://crm.aiemy.com
# 允许调用内部接口的额外 IP（默认只放行本机回环）
TRIAL_ALLOW_IPS=
