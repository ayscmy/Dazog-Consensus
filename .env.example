# 大纵观共识 · 微信推送配置模板
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会入库）

# WxPusher 应用 Token（必填）
# 注册地址：https://wxpusher.zjiecode.com/admin/ ，创建应用后获取 appToken
WXPUSHER_APP_TOKEN=

# 接收用户 UID，逗号分隔（可选）
# 用户微信扫码关注「大纵观共识」应用后，在 WxPusher 后台「用户管理」查看其 UID
# 也可用命令登记：python push_wechat.py --add-uid UID_xxxxxxxxxxxx
WXPUSHER_UIDS=
